    <!-- JavaScript Navigation and Interactions -->
    <script>
        // Tab switching logic
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('tab-active'));

            document.getElementById(tabId).classList.remove('hidden');
            document.getElementById('nav-' + tabId).classList.add('tab-active');

            // Close mobile sidebar if open
            document.getElementById('sidebar').classList.add('-translate-x-full');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Sub-tab switching logic for Materi
        function switchSubTab(subId) {
            document.querySelectorAll('.sub-materi-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.subnav-btn').forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });

            document.getElementById(subId).classList.remove('hidden');
            const activeBtn = document.getElementById('btn-' + subId.replace('materi-', 'sub-'));
            if(activeBtn) {
                activeBtn.classList.remove('bg-white', 'text-slate-700');
                activeBtn.classList.add('bg-brand-600', 'text-white');
            }
        }

        // Modal Helpers
        function expandImage(src, title) {
            document.getElementById('modalImage').src = src;
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('imageModal').classList.remove('hidden');
        }

        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // GFR / NFP Calculator Logic
        function calculateNFP() {
            const pg = parseFloat(document.getElementById('calcPg').value) || 0;
            const pb = parseFloat(document.getElementById('calcPb').value) || 0;
            const pie = parseFloat(document.getElementById('calcPie').value) || 0;

            const nfp = pg - (pb + pie);
            const resDiv = document.getElementById('nfpResult');
            resDiv.innerHTML = `Hasil NFP: <strong>${nfp} mmHg</strong> ${nfp > 0 ? '(Penyaringan Berjalan Normal)' : '(Filtrasi Terhenti)'}`;
        }

        // Quiz State Logic
        let currentScore = 0;
        const answered = { 1: false, 2: false, 3: false };

        function checkQuiz(qNum, choice, isCorrect) {
            if(answered[qNum]) return;
            answered[qNum] = true;

            const feedback = document.getElementById(`q${qNum}-feedback`);
            feedback.classList.remove('hidden');

            if(isCorrect) {
                currentScore++;
                feedback.innerText = '✓ Benar! Jawaban Anda tepat.';
                feedback.className = 'text-xs font-semibold text-emerald-600 mt-1';
            } else {
                feedback.innerText = '✗ Kurang tepat. Silakan ulas kembali materi.';
                feedback.className = 'text-xs font-semibold text-rose-600 mt-1';
            }

            document.getElementById('quizScoreDisplay').innerText = `Skor: ${currentScore} / 3`;
        }

        // Add Comment simulation
        function addComment() {
            const input = document.getElementById('commentInput');
            if(!input.value.trim()) return;

            const list = document.getElementById('commentList');
            const newComment = document.createElement('div');
            newComment.className = 'p-3 bg-brand-50/60 rounded-xl border border-brand-100 space-y-1';
            newComment.innerHTML = `
                <div class="flex justify-between text-xs">
                    <span class="font-bold text-brand-900">Peserta Diskusi</span>
                    <span class="text-slate-400">Baru saja</span>
                </div>
                <p class="text-xs text-slate-700">${input.value}</p>
            `;
            list.prepend(newComment);
            input.value = '';
        }

        // Mobile Sidebar Toggle Listener
        document.getElementById('mobileMenuBtn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.remove('-translate-x-full');
        });
        document.getElementById('closeSidebarBtn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.add('-translate-x-full');
        });
    </script>
